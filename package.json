{
  "name": "plgauge",
  "version": "0.1.0",
  "description": "Measures how good your utPLSQL tests are: branch, condition and MC/DC coverage plus mutation testing",
  "scripts": {
    "typecheck": "tsc",
    "test": "node --import tsx --test --test-concurrency=1 packages/*/test/*.test.ts",
    "plgauge": "tsx packages/cli/src/cli.ts",
    "parity:finder": "tsx scripts/finder-parity.ts",
    "parity:coverage": "tsx scripts/coverage-parity.ts",
    "demo": "tsx packages/cli/src/cli.ts coverage --config examples/order_pricing/plcov.json"
  },
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/oracledb": "^26.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  }
}
